# Copy into `.env.local` (local) or set on Vercel (production).
# Names must match exactly — wrong names break login.

# Optional: this site's public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required: Firebase *web* config JSON (one line). Powers Google / X / email login.
NEXT_PUBLIC_DRAWSY_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# Required: server-only Drawsy API (NOT NEXT_PUBLIC_).
# Local backend: http://127.0.0.1:3004
# Production API: https://api.drawsyai.com
DRAWSY_BACKEND_URL=https://api.drawsyai.com
